# SALKN — локальные доступы. Заполняйте значения после знака =.
# Этот файл не входит в сайт. Не загружать в публичную папку хостинга.
# Не присылайте содержимое в чат или на скриншотах.

# Токен, выданный официальным @BotFather:
TELEGRAM_BOT_TOKEN=
# Можно оставить пустым: определим после сообщения /start вашему боту.
TELEGRAM_CHAT_ID=

# SSH/SFTP из раздела «Доступы» услуги хостинга REG.RU.
# Здесь нужен доступ к хостингу, а не пароль всего аккаунта REG.RU.
HOSTING_HOST=server159.hosting.reg.ru
HOSTING_PORT=22
HOSTING_USER=u3649492
HOSTING_PASSWORD=
# Если используете SSH-ключ, вместо пароля укажите путь к ключу:
HOSTING_KEY_PATH=

PRIMARY_DOMAIN=salkn.ru
SECONDARY_DOMAIN=salkn.online
